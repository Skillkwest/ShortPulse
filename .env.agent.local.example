# ShortPulse local agent helper env.
# Copy to `.env.agent.local` at repo root (ignored by git).

# Optional local app base URL for repo scripts that target localhost.
SHORTPULSE_API_BASE_URL=

# App host for staging/deployed API probes.
SHORTPULSE_STAGING_BASE_URL=

# Optional bearer token for protected-route probe scripts.
SHORTPULSE_STAGING_BEARER_TOKEN=

# Reconciler auth for /api/internal/generation-recovery/run.
SHORTPULSE_FAL_RECONCILER_CRON_SECRET=
CRON_SECRET=

# Optional Supabase bootstrap token inputs (for --bootstrap-token-from-supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback app URL.
APP_BASE_URL=

# Optional Vercel operator tokens for deployment/env audits.
SHORTPULSE_VERCEL_API_TOKEN=
VERCEL_API_TOKEN=
SHORTPULSE_VERCEL_PROTECTION_BYPASS_TOKEN=
VERCEL_AUTOMATION_BYPASS_TOKEN=

# Optional audit/e2e helper env.
PLAYWRIGHT_AUDIT_EMAIL=
PLAYWRIGHT_AUDIT_PASSWORD=
PLAYWRIGHT_BASE_URL=http://localhost:3100
AI_STUDIO_PERF_PORT=3100
AI_STUDIO_PERF_SKIP_BUILD=false

# Optional local governance/contract guardrail modes.
SHORTPULSE_MODEL_CATALOG_MAX_STALE_DAYS=45
SHORTPULSE_MODEL_CATALOG_STALE_MODE=warn
ARCHITECTURE_BOUNDARY_MODE=warn
REFERENCE_GRID_BOUNDARY_MODE=warn
REFERENCE_GRID_SIZE_BUDGET_MODE=warn
