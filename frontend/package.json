{
  "name": "shortflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:generation-worker": "node ./scripts/run_generation_control_plane_worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:phase11:fal-regression": "vitest run tests/api/fal-route-inventory-regression.test.ts tests/api/fal-submit-proxy.test.ts tests/api/fal-queue-status.test.ts tests/api/fal-status-proxy.test.ts tests/api/veo-first-last-frame-submit.test.ts lib/server/api/__tests__/generationQueue.dispatch.integrity.test.ts lib/server/falIntegration/__tests__/recoveryProviderProbe.test.ts lib/server/falIntegration/__tests__/recoveryExecutionRuntime.test.ts lib/server/falIntegration/__tests__/recoveryExecution.test.ts lib/server/falIntegration/__tests__/statusProxyRuntime.test.ts lib/server/providerIntegration/__tests__/statusProviderDispatcher.test.ts lib/server/providerIntegration/__tests__/statusProviderTopology.test.ts lib/server/providerIntegration/__tests__/statusProviderPayload.test.ts lib/server/providerIntegration/__tests__/statusProviderPolling.test.ts lib/server/providerIntegration/__tests__/statusProviderSelection.test.ts lib/server/providerIntegration/__tests__/statusProviderPolicy.test.ts",
    "validate:phase11:fal-regression": "npm run test:phase11:fal-regression && npm run type-check && npm run lint && npm run docs:check && npm run build",
    "phase11:gate-eval": "cd .. && node scripts/phase11_evaluate_gate_summary.mjs",
    "phase11:window-guard": "cd .. && node scripts/phase11_checkpoint_window_guard.mjs",
    "phase13:waveh:capture": "cd .. && node scripts/phase13_wave_h_capture_packet.mjs",
    "audit:staging:openai-lanes": "cd .. && node scripts/audit_staging_openai_lane_bundle.mjs",
    "audit:staging:openai-lanes:strict": "cd .. && node scripts/audit_staging_openai_lane_bundle.mjs --max-fallback-rate 0.05 --max-upstream-error-rate 0.05 --max-non-200-rate 0.05 --max-missing-machine-outcome-rate 0 --require-contract-version 1 --require-success-prompt",
    "audit:staging:openai-lanes:strict:lineage": "cd .. && node scripts/audit_staging_openai_lane_bundle.mjs --lineage-precheck --lineage-max-age-hours 72 --max-fallback-rate 0.05 --max-upstream-error-rate 0.05 --max-non-200-rate 0.05 --max-missing-machine-outcome-rate 0 --require-contract-version 1 --require-success-prompt",
    "cleanup:test-auth-users": "cd .. && node scripts/cleanup_test_auth_users.mjs",
    "cleanup:test-auth-users:dry": "cd .. && node scripts/cleanup_test_auth_users.mjs --dry-run",
    "phase12:execution-gate": "cd .. && node scripts/phase12_execution_gate.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:adaptive-v2-gate": "npm run lint && npm run type-check && npm run test -- ReferenceGrid.curated.test.tsx referenceGridMedia.test.ts referenceGridMedia.parity.test.ts MediaLibraryModal.test.tsx CharacterManagerShell.behavior.test.tsx lib/adaptive-media/__tests__/policy.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:character": "NODE_PATH=./node_modules node ./tests/e2e/character-pipeline.audit.js",
    "test:e2e:media-library-runtime": "NODE_PATH=./node_modules node ./tests/e2e/media-library-runtime.audit.js",
    "test:e2e:style-drop": "NODE_PATH=./node_modules node ./tests/e2e/ai-studio-style-drop.audit.js",
    "test:e2e:expert-edit-parity": "NODE_PATH=./node_modules node ./tests/e2e/expert-edit-coordinate-parity.audit.js",
    "test:expert-edit:coordinate-parity:core": "vitest run features/ai-studio/components/edit/__tests__/stageSceneGeometry.test.ts features/ai-studio/components/edit/__tests__/markupStrokeController.test.ts features/ai-studio/components/edit/__tests__/useInpaintMaskController.test.ts features/ai-studio/components/edit/__tests__/useExpertEditTransformController.test.tsx features/ai-studio/logic/__tests__/expertEditStageFlatten.test.ts features/ai-studio/components/__tests__/ExpertEditPanelView.test.tsx",
    "test:expert-edit:coordinate-parity:browser-audit": "npm run test:e2e:expert-edit-parity",
    "test:expert-edit:coordinate-parity:gate": "npm run test:expert-edit:coordinate-parity:core",
    "test:perf:ai-studio": "NODE_PATH=./node_modules node ./tests/e2e/ai-studio-perf.audit.js",
    "test:agent:contract": "cd .. && node scripts/check_agent_contract_tests.js",
    "test:agent:disable-continuity": "cd .. && node scripts/check_agent_disable_continuity.js",
    "perf:ai-studio:release-check": "node ./scripts/ai-studio-perf-release-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run type-check && npm run check:test-script-paths && npm run check:naming-legacy-usage && npm run check:style-literal-guard && npm run test",
    "validate:lane-b-convergence": "npm run validate && EXPERT_EDIT_SIZE_BUDGET_MODE=enforce CHARACTER_MANAGER_SIZE_BUDGET_MODE=enforce ADMIN_HEALTH_SIZE_BUDGET_MODE=enforce npm run check:size-budget && EXPERT_EDIT_BOUNDARY_MODE=enforce CHARACTER_MANAGER_BOUNDARY_MODE=enforce ADMIN_HEALTH_BOUNDARY_MODE=enforce EXPERT_EDIT_CYCLE_MODE=enforce CHARACTER_MANAGER_CYCLE_MODE=enforce ADMIN_HEALTH_CYCLE_MODE=enforce npm run check:architecture-boundary && npm run docs:check",
    "validate:media-rendering-guardrails": "MEDIA_RENDERING_SIZE_BUDGET_MODE=enforce CHARACTER_MANAGER_SIZE_BUDGET_MODE=enforce npm run check:size-budget && REFERENCE_GRID_BOUNDARY_MODE=enforce MEDIA_RENDERING_BOUNDARY_MODE=enforce CHARACTER_MANAGER_BOUNDARY_MODE=enforce npm run check:architecture-boundary && npm run docs:check",
    "check:lane-d-strict-runtime": "eslint pages features lib --ext .ts,.tsx,.js,.jsx --rule 'react-hooks/set-state-in-effect:error' --rule 'react-hooks/exhaustive-deps:error'",
    "validate:lane-d-runtime": "npm run lint && npm run type-check && npm run check:architecture-boundary && npm run check:size-budget && npm run build && npm run docs:check && npm run check:lane-d-strict-runtime",
    "validate:lane-e-governance": "npm run validate && npm run build && npm run docs:check",
    "validate:lane-f-governance": "npm run lint && npm run type-check && npm run build && npm run docs:check",
    "check:architecture-boundary": "cd .. && node scripts/check_architecture_boundaries.js",
    "check:size-budget": "cd .. && node scripts/check_size_budgets.js",
    "check:test-script-paths": "cd .. && node scripts/check_npm_script_paths.js frontend/package.json",
    "check:style-literal-guard": "cd .. && node scripts/check_ai_studio_style_literals.js",
    "check:naming-legacy-usage": "cd .. && node scripts/check_naming_legacy_usage.js",
    "db:migrate": "cd .. && node scripts/db_migrate_guardrail.mjs",
    "db:reset": "cd .. && echo 'Blocked by repo policy: local Supabase reset is not allowed. Use db:migrate and docs/sops/sop_sql_migration_operations.md.' && exit 1",
    "docs:check": "cd .. && node scripts/check_docs_links.js && node scripts/check_docs_semantic_drift.js && node scripts/check_migration_doc_parity.js && node scripts/check_archive_manifest.js && node scripts/check_model_catalog_parity.js && node scripts/check_naming_canonical_drift.js && node scripts/check_operator_map_drift.js",
    "deadcode:check": "knip --production --include files --max-issues 0",
    "deadcode:check:full": "knip --production --include files,exports,dependencies --no-exit-code",
    "latency:protected-route": "cd .. && node scripts/capture_protected_route_latency.mjs",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "formidable": "^3.5.4",
    "next": "^16.1.7",
    "phosphor-react": "^1.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.7.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.11.24",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.8.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^5.84.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "supabase": "^2.76.7",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "knip": {
    "ignoreFiles": [
      "features/ai-studio/components/canvas/__tests__/canvasTestHarness.tsx",
      "features/agent-runtime/canaryThresholdDecision.ts",
      "lib/server/providerIntegration/__tests__/fixtures/kieContractFixtures.ts",
      "scripts/ai-studio-perf-release-check.mjs",
      "tests/e2e/ai-studio-perf.audit.js",
      "tests/e2e/expert-edit-coordinate-parity.audit.js",
      "tests/e2e/ai-studio-style-drop.audit.js",
      "tests/e2e/character-pipeline.audit.js",
      "vitest.setup.ts"
    ]
  }
}
