{
  "name": "shortflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/run_dev_with_generation_worker.mjs",
    "dev:next": "next dev",
    "dev:generation-worker": "node ./scripts/run_generation_control_plane_worker.mjs",
    "ophestivus:intake": "node ./scripts/ophestivus_intake.mjs",
    "ophestivus:review": "node ./scripts/ophestivus_review.mjs",
    "ophestivus:error-status": "node ./scripts/ophestivus_error_status.mjs",
    "ophestivus:error-event-detail": "node ./scripts/ophestivus_error_event_detail.mjs",
