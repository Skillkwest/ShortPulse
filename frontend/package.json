    "audit:staging:openai-lanes:strict:lineage": "cd .. && node scripts/audit_staging_openai_lane_bundle.mjs --lineage-precheck --lineage-max-age-hours 72 --max-fallback-rate 0.05 --max-upstream-error-rate 0.05 --max-non-200-rate 0.05 --max-missing-machine-outcome-rate 0 --require-contract-version 1 --require-success-prompt",
    "audit:character-sheet-alias-readiness": "cd .. && node scripts/check_character_sheet_alias_readiness.mjs",
    "cleanup:test-auth-users": "cd .. && node scripts/cleanup_test_auth_users.mjs",
    "cleanup:test-auth-users:dry": "cd .. && node scripts/cleanup_test_auth_users.mjs --dry-run",
