# ShortPulse frontend
# Copy this file to `.env.local` in the same folder and fill in the values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side API keys (never expose to the client)
APP_BASE_URL=http://localhost:3000
# Optional canonical external API base used for server routes that need a public origin.
# Falls back to APP_BASE_URL when unset.
SHORTPULSE_PUBLIC_API_BASE_URL=
SHORTPULSE_STAGING_BASE_URL=
SHORTPULSE_STAGING_BEARER_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
FAL_KEY=your_fal_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
SHORTPULSE_ADMIN_EMAILS=
SHORTPULSE_TRUST_PROXY_AUTH_HEADERS=false
SHORTPULSE_RELEASE=
# Optional local tooling base URL fallback used by repo scripts.
SHORTPULSE_API_BASE_URL=http://localhost:3000
OPENAI_MODEL=gpt-5-nano
OPENAI_VISION_MODEL=gpt-5-nano
# Optional: pin stage-specific models for thinker/formatter orchestration.
STUDIO_AGENT_THINKER_MODEL=
STUDIO_AGENT_FORMATTER_MODEL=
OPENAI_VISION_FALLBACK_MODEL=gpt-5-nano
# Optional prompt overrides; leave blank to use built-in defaults.
OPENAI_PROMPT_SYSTEM=
OPENAI_PROMPT_IMAGE_DESCRIBE=
OPENAI_PROMPT_STYLE_EXTRACT=
# Optional test/debug gate used by describe-image route tests.
OPENAI_DESCRIBE_REQUIRE_ALLOWED_HOSTS=
# OpenAI compatibility transport toggles.
SHORTPULSE_OPENAI_RESPONSES_ENABLED=false
SHORTPULSE_OPENAI_CHAT_FALLBACK_ENABLED=true
# Optional: comma-separated hostnames for describe-image URL allowlist
# Supports exact hostnames and wildcard suffixes like "*.example.com".
OPENAI_DESCRIBE_ALLOWED_HOSTS=
# Media direct-preview trust policy. Keep server and client values aligned.
# Built-in provider result hosts used by supported generation flows remain allowed
# when external previews are enabled (for example `tempfile.aiquickdraw.com`).
SHORTPULSE_MEDIA_DIRECT_URL_ALLOWED_HOSTS=
SHORTPULSE_MEDIA_ALLOW_EXTERNAL_DIRECT_PREVIEWS=false
NEXT_PUBLIC_MEDIA_DIRECT_URL_ALLOWED_HOSTS=
NEXT_PUBLIC_MEDIA_ALLOW_EXTERNAL_DIRECT_PREVIEWS=false
# Media Library server-authoritative upload route rollout.
SHORTPULSE_MEDIA_UPLOAD_API_ENABLED=true
NEXT_PUBLIC_MEDIA_UPLOAD_API_ENABLED=true
# Media Library server-authoritative list/runtime rollout.
SHORTPULSE_MEDIA_LIST_API_ENABLED=true
NEXT_PUBLIC_MEDIA_LIST_API_ENABLED=true
# Character-scope containment for Media Library list surfaces (`<uid>/characters/*` exclusion).
SHORTPULSE_MEDIA_LIBRARY_EXCLUDE_CHARACTER_SCOPE=true
NEXT_PUBLIC_MEDIA_LIBRARY_VIRTUALIZATION_ENABLED=true
NEXT_PUBLIC_MEDIA_LIBRARY_VIDEO_BUDGET_ENABLED=true
NEXT_PUBLIC_MEDIA_LIBRARY_SIGN_PREFETCH_ENABLED=true
# Character panel media isolation rollout (character_media_assets-first persistence).
SHORTPULSE_CHARACTER_MEDIA_V2_WRITES_ENABLED=false
SHORTPULSE_CHARACTER_MEDIA_V2_READS_ENABLED=false
NEXT_PUBLIC_CHARACTER_MEDIA_V2_WRITES_ENABLED=false
NEXT_PUBLIC_CHARACTER_MEDIA_V2_READS_ENABLED=false
# Signed preview transform policy: both flags must be true to allow transforms.
SHORTPULSE_MEDIA_SIGNED_TRANSFORMS_ENABLED=false
NEXT_PUBLIC_MEDIA_SIGNED_TRANSFORMS_ENABLED=false
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
SHORTPULSE_INTERNAL_BILLING_RENEWALS_ENABLED=false
SHORTPULSE_INTERNAL_BILLING_RENEWALS_CRON_SECRET=
SHORTPULSE_INTERNAL_BILLING_RENEWAL_BATCH_SIZE=100

# AI Studio agent runtime rollout flags
NEXT_PUBLIC_ENABLE_STUDIO_AGENT=true
NEXT_PUBLIC_AGENT_V2=true
NEXT_PUBLIC_ENABLE_EXPERT_CREATE_UI=
# Locks Expert Edit Markup tool to Pulse Markup v1 model/branding when true.
NEXT_PUBLIC_AI_STUDIO_MARKUP_MODEL_LOCK_ENABLED=false
# Prototype toggle: clicking collapsed Tools opens expanded Markup modal directly;
# closing the modal re-collapses Tools when enabled.
NEXT_PUBLIC_AI_STUDIO_MARKUP_COLLAPSED_OPEN_MODAL_ENABLED=false
# Markup generate prototype: when Markup is selected and strokes exist, attach
# flattened layers+strokes as a secondary reference input.
NEXT_PUBLIC_AI_STUDIO_MARKUP_STROKE_SECONDARY_REFERENCE_ENABLED=false
# Edit selector-row prototype: show Standard/Inpaint/Markup generation mode tabs.
NEXT_PUBLIC_AI_STUDIO_EDIT_GENERATION_MODE_TOGGLE_ENABLED=true
# Dashboard temporary simplification toggle (`false` restores legacy quick-start/workflow/tools/footer blocks).
NEXT_PUBLIC_DASHBOARD_HIDE_LEGACY_SECTIONS=true
NEXT_PUBLIC_SHORTPULSE_BEGINNER_MODE_FORCE_OFF=true
NEXT_PUBLIC_SHORTPULSE_BEGINNER_MODE_TOGGLE_VISIBLE=false
NEXT_PUBLIC_SHORTPULSE_RELEASE=
NEXT_PUBLIC_AI_STUDIO_PERF_PROFILE=stable
# Set to `legacy` only for temporary rollback to pre-stabilization default perf toggles.
NEXT_PUBLIC_REFERENCE_GRID_SOFT_ARCHIVE=true
NEXT_PUBLIC_REFERENCE_GRID_ACTIVE_LIMIT=500
NEXT_PUBLIC_REFERENCE_GRID_ARCHIVE_PREVIEW_KEEP_COUNT=120
NEXT_PUBLIC_REFERENCE_GRID_ADAPTIVE_PREVIEW=true
NEXT_PUBLIC_REFERENCE_GRID_CURATED_SPLIT=true
NEXT_PUBLIC_REFERENCE_GRID_STRICT_PREVIEW_LADDER=true
NEXT_PUBLIC_REFERENCE_GRID_UPDATE_BACKPRESSURE=true
NEXT_PUBLIC_REFERENCE_GRID_DECODE_BUDGET=true
NEXT_PUBLIC_REFERENCE_GRID_DYNAMIC_VIRTUALIZATION=true
NEXT_PUBLIC_REFERENCE_GRID_DENSE_VISUAL_SIMPLIFY=true
NEXT_PUBLIC_REFERENCE_GRID_MEMORY_GUARD=true
NEXT_PUBLIC_REFERENCE_GRID_PERF_WATCHDOG=true
NEXT_PUBLIC_REFERENCE_GRID_HARD_VIEWPORT_CAP=true
NEXT_PUBLIC_REFERENCE_GRID_CSS_CONTAINMENT=true
NEXT_PUBLIC_REFERENCE_GRID_LOADING_PLACEHOLDER_TIMEOUT=true
NEXT_PUBLIC_REFERENCE_GRID_GLOBAL_MEDIA_BUDGET=true
NEXT_PUBLIC_REFERENCE_GRID_ADAPTIVE_PREVIEW_QUALITY=true
# Optional heavy-load image long-edge compaction at sustained pressure level 2 (default off).
NEXT_PUBLIC_REFERENCE_GRID_HEAVY_LOAD_LONG_EDGE_COMPACTION=false
NEXT_PUBLIC_REFERENCE_GRID_TELEMETRY_BACKPRESSURE=true
NEXT_PUBLIC_REFERENCE_GRID_RENDER_COMMIT_TELEMETRY=false
NEXT_PUBLIC_REFERENCE_GRID_PRECONNECT_HINTS=true
NEXT_PUBLIC_REFERENCE_GRID_TRANSITION_NONURGENT=true
NEXT_PUBLIC_MEDIA_ADAPTIVE_V2_ENABLED=false
NEXT_PUBLIC_MEDIA_ADAPTIVE_V2_SHADOW_COMPARE=false
NEXT_PUBLIC_MEDIA_ADAPTIVE_V2_TUNED_POLICY=false
# Recommended set for media-library parity (when Adaptive V2 is enabled):
# reference-grid,media-library-grid,media-library-modal-grid
# Expanded set example:
# reference-grid,quick-slot,media-library-grid,media-library-modal-grid,character-grid
NEXT_PUBLIC_MEDIA_ADAPTIVE_V2_SURFACES=reference-grid,media-library-grid,media-library-modal-grid
NEXT_PUBLIC_MEDIA_ADAPTIVE_V2_FORCE_FULL_QUALITY=false
# AI Studio Media Library panel compression gate (default off).
# Signed Supabase preview URLs now bypass Next optimizer wrapping on media-library surfaces.
NEXT_PUBLIC_MEDIA_LIBRARY_PANEL_CONSTANT_COMPRESSION_ENABLED=false
NEXT_PUBLIC_AI_STUDIO_MEDIA_LIBRARY_GESTURE_V2_ENABLED=false
NEXT_PUBLIC_AI_STUDIO_MEDIA_LIBRARY_PANEL_ENABLED=true
NEXT_PUBLIC_AI_STUDIO_SHELL_DECOUPLE=true
NEXT_PUBLIC_AI_STUDIO_DND_BACKPRESSURE=true
NEXT_PUBLIC_AI_STUDIO_PANEL_MEMOIZATION=true
NEXT_PUBLIC_AI_STUDIO_HIGH_DENSITY_SHELL_MODE=true
NEXT_PUBLIC_AI_STUDIO_OUTPUT_SELECTOR_STORE=true
NEXT_PUBLIC_AI_STUDIO_SHELL_BOUNDARY_SPLIT=true
NEXT_PUBLIC_AI_STUDIO_SELECTOR_CALLBACKS=true
NEXT_PUBLIC_AI_STUDIO_PAGE_OUTPUT_DECOUPLE=true
NEXT_PUBLIC_AI_STUDIO_RAF_STATUS_FLUSH=true
NEXT_PUBLIC_AI_STUDIO_PERF_AUDIT_RUNTIME=false
NEXT_PUBLIC_AI_STUDIO_MODAL_STABILITY_V1=false
SHORTPULSE_AI_STUDIO_SESSIONS_API_ENABLED=false
# AI Studio session persistence stays off by default; opt in only for controlled testing.
NEXT_PUBLIC_AI_STUDIO_SESSION_PERSISTENCE_ENABLED=false
NEXT_PUBLIC_AI_STUDIO_SESSION_WRITE_SHADOW_ENABLED=false
NEXT_PUBLIC_AI_STUDIO_SESSION_REMOTE_SHADOW_ENABLED=false
NEXT_PUBLIC_AI_STUDIO_SESSION_RESTORE_SHADOW_ENABLED=false
NEXT_PUBLIC_AI_STUDIO_SESSION_RESTORE_APPLY_ENABLED=false
NEXT_PUBLIC_AI_STUDIO_SESSION_RESTORE_APPLY_AGENT_ENABLED=false
# Emergency kill switch for styles drop server-copy fallback lane (happy path remains active).
NEXT_PUBLIC_AI_STUDIO_STYLE_DROP_SERVER_COPY_FALLBACK_ENABLED=true
NEXT_PUBLIC_AI_STUDIO_STYLE_FAMILY_ADAPTER_ENABLED=true
# Optional test/debug gate used by submission payload matrix tests.
NEXT_PUBLIC_AI_STUDIO_GENERATION_SAFETY_LEVEL=off
# Emergency stabilization kill switch for per-tool workflow settings hydration/persist.
NEXT_PUBLIC_AI_STUDIO_WORKFLOW_SETTINGS_PERSIST_ENABLED=false
NEXT_PUBLIC_STUDIO_AGENT_SAFETY_PROFILE_ACTIVE=prod_safe_v1
NEXT_PUBLIC_STUDIO_AGENT_SAFETY_DEV_ABSOLUTE_ZERO_ENABLED=false
STUDIO_AGENT_ENABLED=true
STUDIO_AGENT_SYSTEM=
STUDIO_AGENT_THINKER=
STUDIO_AGENT_FORMATTER=
STUDIO_AGENT_CANONICAL_DB_ENABLED=true
STUDIO_AGENT_SERVER_VISION_ENABLED=true
STUDIO_AGENT_TEXT_FAST_PATH_ENABLED=true
STUDIO_AGENT_SINGLE_STAGE_ENABLED=true
STUDIO_AGENT_LEGACY_V2_FALLBACK_ENABLED=false
STUDIO_AGENT_DIRECT_OPENAI_BYPASS_ENABLED=false
STUDIO_AGENT_DIRECT_OPENAI_MODEL=gpt-5.4
NEXT_PUBLIC_STUDIO_AGENT_DIRECT_OPENAI_BYPASS_ENABLED=false
STUDIO_AGENT_SAFETY_INPUT_PRECHECK_ENABLED=true
STUDIO_AGENT_SAFETY_INPUT_PRECHECK_GENERATE_PROMPT_ENABLED=true
STUDIO_AGENT_SAFETY_INPUT_PRECHECK_GENERATION_SUBMIT_ENABLED=true
# Optional JSON override for shared field-mode scope (example):
# {"history_user_turn":"shadow","reference_caption":"rewrite_only"}
STUDIO_AGENT_SAFETY_INPUT_PRECHECK_FIELD_MODES=
# Optional route-scoped JSON overrides (merged over shared modes).
STUDIO_AGENT_SAFETY_INPUT_PRECHECK_FIELD_MODES_STUDIO_AGENT=
STUDIO_AGENT_SAFETY_INPUT_PRECHECK_FIELD_MODES_GENERATE_PROMPT=
STUDIO_AGENT_SAFETY_INPUT_PRECHECK_FIELD_MODES_GENERATION_SUBMIT=
STUDIO_AGENT_SAFETY_PROFILE_ACTIVE=prod_safe_v1
NEXT_PUBLIC_STUDIO_AGENT_SAFETY_INPUT_PRECHECK_ENABLED=true
# Optional client mirror JSON overrides for pre-send parity.
NEXT_PUBLIC_STUDIO_AGENT_SAFETY_INPUT_PRECHECK_FIELD_MODES=
NEXT_PUBLIC_STUDIO_AGENT_SAFETY_INPUT_PRECHECK_FIELD_MODES_STUDIO_AGENT=
STUDIO_AGENT_SAFETY_IMAGE_PREFLIGHT_ENABLED=true
STUDIO_AGENT_SAFETY_IMAGE_PREFLIGHT_FAIL_MODE=prod_closed_nonprod_open
STUDIO_AGENT_SAFETY_POSTPROCESS_ENABLED=true
STUDIO_AGENT_SAFETY_POSTPROCESS_MODE=enforce
STUDIO_AGENT_SAFETY_DEBUG=false
STUDIO_AGENT_SAFETY_DEV_ABSOLUTE_ZERO_ENABLED=false
STUDIO_AGENT_SAFETY_PROVIDER_ERROR_MODE=production_normalized
STUDIO_AGENT_SAFETY_AUTOROLLBACK_ENABLED=false
STUDIO_AGENT_SAFETY_ROLLBACK_COOLDOWN_HOURS=24
STUDIO_AGENT_SAFETY_RUNTIME_CONTROL_PLANE_SYNC_ENABLED=true
STUDIO_AGENT_SAFETY_RUNTIME_CONTROL_PLANE_CACHE_TTL_MS=5000
STUDIO_AGENT_DEPRECATION_DOC_URL=
STUDIO_AGENT_TIMEOUT_MS=20000
STUDIO_AGENT_VISION_TIMEOUT_MS=20000
STUDIO_AGENT_TURN_TIMEOUT_MS=20000
STUDIO_AGENT_UPSTREAM_MAX_ATTEMPTS=2
STUDIO_AGENT_UPSTREAM_RETRY_BASE_MS=150
STUDIO_AGENT_UPSTREAM_RETRY_MAX_MS=1200

# Admin error-event spike alert thresholds (15-minute windows)
SHORTPULSE_ADMIN_ALERT_TOTAL_15M=40
SHORTPULSE_ADMIN_ALERT_HIGH_15M=8
SHORTPULSE_ADMIN_ALERT_GENERATION_15M=20
SHORTPULSE_ADMIN_ALERT_PROVIDER_RUNNING_TIMEOUT_15M=2
SHORTPULSE_ADMIN_ALERT_USER_HEALTH_FLEET_CRITICAL_RISK=80
SHORTPULSE_ADMIN_ALERT_USER_HEALTH_FLEET_WARNING_COST_WITHOUT_SUCCESS_CENTS=2000

# Fal runtime v2 rollout + operations
SHORTPULSE_FAL_INTEGRATION_MODE=legacy
SHORTPULSE_FAL_INTEGRATION_MODEL_ALLOWLIST=
# Video submit canonical contract rollout.
# off: bypass canonical ingress layer for video models
# shadow: evaluate/log canonical violations without rejecting at ingress
# on: strict fail-closed canonical ingress validation for video models
SHORTPULSE_VIDEO_SUBMIT_CANONICAL_MODE=on
# Queue dispatch legacy compatibility normalization for video payloads:
# true: allow legacy raw queue rows via compatibility normalization
# false: require v2 queue envelope payloads (legacy rows exhaust deterministically)
SHORTPULSE_VIDEO_QUEUE_COMPAT_NORMALIZATION_ENABLED=true
# Optional legacy fallback secret for Fal webhook compatibility.
SHORTPULSE_FAL_WEBHOOK_SECRET=
# Legacy alias retained for compatibility fallback.
FAL_WEBHOOK_SECRET=
# Active posture: standard Fal/Kie generation submits directly to the provider.
# Reconciler remains for accepted-job recovery, not for pre-provider queueing.
SHORTPULSE_FAL_RECONCILER_ENABLED=false
SHORTPULSE_FAL_RECONCILER_CRON_SECRET=
# Optional manual/fallback bearer secret for /api/internal/generation-recovery/run.
CRON_SECRET=
SHORTPULSE_FAL_RECONCILER_BATCH_SIZE=25
SHORTPULSE_FAL_RECONCILER_MAX_ATTEMPTS=5
SHORTPULSE_FAL_RECONCILER_MIN_AGE_SECONDS=120
SHORTPULSE_FAL_RECONCILER_LEASE_SECONDS=120
SHORTPULSE_FAL_STATUS_TRANSIENT_FAILURES_ENABLED=false
SHORTPULSE_FAL_CIRCUIT_BREAKER_ENABLED=false
SHORTPULSE_FAL_CIRCUIT_BREAKER_THRESHOLD_15M=20
SHORTPULSE_FAL_ADMISSION_MODE=off
SHORTPULSE_FAL_ADMISSION_GLOBAL_MAX=4
SHORTPULSE_FAL_ADMISSION_TIER_LIMITS_JSON={"video_long":2,"image_heavy":3,"image_standard":4}
SHORTPULSE_FAL_ADMISSION_RETRY_AFTER_SECONDS=20
SHORTPULSE_FAL_ADMISSION_ATOMIC_ENABLED=false
SHORTPULSE_FAL_TRUSTED_HOSTS=
SHORTPULSE_FAL_RECOVERY_PROBE_TIMEOUT_MS=15000
SHORTPULSE_FAL_RESERVATION_CLEANUP_ENABLED=false
SHORTPULSE_FAL_RESERVATION_CLEANUP_MIN_AGE_SECONDS=900
SHORTPULSE_FAL_RESERVATION_CLEANUP_BATCH_SIZE=200
SHORTPULSE_FAL_PROVIDER_ATTACHED_RESERVATION_CLEANUP_ENABLED=false
SHORTPULSE_FAL_PROVIDER_ATTACHED_RESERVATION_CLEANUP_MIN_AGE_SECONDS=7200
SHORTPULSE_FAL_PROVIDER_ATTACHED_RESERVATION_ORPHAN_MIN_AGE_SECONDS=86400
SHORTPULSE_FAL_NO_MEDIA_EXHAUST_MIN_AGE_SECONDS=7200
SHORTPULSE_FAL_RUNNING_EXHAUST_MIN_AGE_SECONDS=7200
# Optional hard timeout for provider-running jobs. 0 disables absolute timeout.
SHORTPULSE_FAL_RUNNING_HARD_TIMEOUT_SECONDS=0
# Emergency only: allow fallback from reservation billing to direct debit.
SHORTPULSE_FAL_DIRECT_DEBIT_FALLBACK_ENABLED=false

# Media derivative worker (image thumbs) runtime.
SHORTPULSE_MEDIA_DERIVATIVES_ENABLED=false
SHORTPULSE_MEDIA_DERIVATIVES_CRON_SECRET=
SHORTPULSE_MEDIA_DERIVATIVES_BATCH_SIZE=20
SHORTPULSE_MEDIA_DERIVATIVES_MAX_ATTEMPTS=5
SHORTPULSE_MEDIA_DERIVATIVES_LEASE_SECONDS=180
SHORTPULSE_MEDIA_DERIVATIVES_RETRY_BASE_SECONDS=60
SHORTPULSE_MEDIA_DERIVATIVES_RETRY_MAX_SECONDS=1800
SHORTPULSE_MEDIA_DERIVATIVES_THUMB_240_QUALITY=58
SHORTPULSE_MEDIA_DERIVATIVES_THUMB_480_QUALITY=62

# Admin user-health fleet runtime (daily active-user triage)
SHORTPULSE_USER_HEALTH_FLEET_ENABLED=false
SHORTPULSE_USER_HEALTH_FLEET_CRON_SECRET=
SHORTPULSE_USER_HEALTH_FLEET_LOOKBACK_DAYS=30
SHORTPULSE_USER_HEALTH_FLEET_ACTIVE_WINDOW_DAYS=30
SHORTPULSE_USER_HEALTH_FLEET_RETENTION_DAYS=90
SHORTPULSE_USER_HEALTH_FLEET_MAX_USERS_PER_RUN=1000
SHORTPULSE_USER_HEALTH_FLEET_PAGE_SIZE=100
SHORTPULSE_USER_HEALTH_FLEET_TIME_BUDGET_MS=300000
SHORTPULSE_USER_HEALTH_FLEET_INCIDENTS_ENABLED=false

# Kie runtime (dark path; disabled by default)
SHORTPULSE_KIE_INTEGRATION_ENABLED=false
# Required when integration is enabled (fails closed when empty)
# Allowlist entries are normalized to lowercase and must be canonical Kie ids
# or `*` (global wildcard).
# Example: kie-ai/veo-3.1-fast-i2v,kie-ai/kling-3.0,kie-ai/seedance-1.5-pro,kie-ai/seedance-2,kie-ai/seedance-2-fast
SHORTPULSE_KIE_MODEL_ALLOWLIST=
SHORTPULSE_KIE_API_KEY=
KIE_API_KEY=
# Optional overrides. When unset, Kie submit/status topology is resolved from
# canonical model-catalog contracts per model id.
SHORTPULSE_KIE_SUBMIT_URLS=
# Comma-separated HTTPS URLs. Supports optional `{requestId}` token for providers
# that expose status/details endpoints via query params instead of `/{id}/status`.
SHORTPULSE_KIE_STATUS_BASE_URLS=
SHORTPULSE_KIE_STATUS_TIMEOUT_MS=60000
SHORTPULSE_KIE_TRUSTED_HOSTS=kie.ai

# AI Studio product availability gates
NEXT_PUBLIC_AI_STUDIO_SEEDANCE_2_ENABLED=false
