# ShortPulse local agent helper env.
# Copy to `.env.agent.local` at repo root (ignored by git).

# App host for staging/deployed API probes.
SHORTPULSE_STAGING_BASE_URL=

# Optional bearer token for protected-route probe scripts.
SHORTPULSE_STAGING_BEARER_TOKEN=

# Reconciler auth for /api/internal/generation-recovery/run.
SHORTPULSE_FAL_RECONCILER_CRON_SECRET=
CRON_SECRET=

# Optional Supabase bootstrap token inputs (for --bootstrap-token-from-supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback app URL.
APP_BASE_URL=
