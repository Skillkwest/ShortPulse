    "test:expert-edit:coordinate-parity:browser-audit": "npm run test:e2e:expert-edit-parity",
    "test:expert-edit:coordinate-parity:gate": "npm run test:expert-edit:coordinate-parity:core",
    "test:perf:ai-studio": "NODE_PATH=./node_modules node ./tests/e2e/ai-studio-perf.audit.js",
