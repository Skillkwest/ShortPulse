{
  "name": "shortflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:adaptive-v2-gate": "npm run lint && npm run type-check && npm run test -- ReferenceCanvas.curated.test.tsx referenceGridMedia.test.ts referenceGridMedia.parity.test.ts MediaLibraryModal.test.tsx CharacterManagerShell.behavior.test.tsx lib/adaptive-media/__tests__/policy.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:character": "NODE_PATH=./node_modules node ./tests/e2e/character-pipeline.audit.js",
    "test:perf:ai-studio": "NODE_PATH=./node_modules node ./tests/e2e/ai-studio-perf.audit.js",
    "test:agent:contract": "cd .. && node scripts/check_agent_contract_tests.js",
    "test:agent:disable-continuity": "cd .. && node scripts/check_agent_disable_continuity.js",
    "perf:ai-studio:release-check": "node ./scripts/ai-studio-perf-release-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run type-check && npm run test",
    "check:architecture-boundary": "cd .. && node scripts/check_architecture_boundaries.js",
    "check:size-budget": "cd .. && node scripts/check_size_budgets.js",
    "db:migrate": "cd .. && supabase db push",
    "db:reset": "cd .. && supabase db reset",
    "docs:check": "cd .. && node scripts/check_docs_links.js && node scripts/check_docs_semantic_drift.js && node scripts/check_migration_doc_parity.js && node scripts/check_archive_manifest.js && node scripts/check_model_catalog_parity.js",
    "deadcode:check": "knip --production --include files --max-issues 0",
    "deadcode:check:full": "knip --production --include files,exports,dependencies --no-exit-code",
    "latency:protected-route": "cd .. && node scripts/capture_protected_route_latency.mjs",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "formidable": "^3.5.4",
    "next": "^16.1.6",
    "onnxruntime-web": "^1.23.2",
    "phosphor-react": "^1.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.7.2",
    "swr": "2.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.11.24",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^5.84.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "supabase": "^2.76.7",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "knip": {
    "ignoreFiles": [
      "scripts/ai-studio-perf-release-check.mjs",
      "tests/e2e/ai-studio-perf.audit.js",
      "tests/e2e/character-pipeline.audit.js",
      "vitest.setup.ts"
    ]
  }
}
