      "tests/e2e/ai-studio-perf.audit.js",
      "tests/e2e/expert-edit-coordinate-parity.audit.js",
      "tests/e2e/ai-studio-style-drop.audit.js",
      "tests/e2e/character-pipeline.audit.js",
