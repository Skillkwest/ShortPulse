# ShortPulse local agent helper env.
# Copy to `.env.agent.local` at repo root (ignored by git).

# Optional local app base URL for repo scripts that target localhost.
SHORTPULSE_API_BASE_URL=

# App host for staging/deployed API probes.
SHORTPULSE_STAGING_BASE_URL=

# Optional bearer token for protected-route probe scripts.
SHORTPULSE_STAGING_BEARER_TOKEN=

# Optional dedicated development Supabase project inputs.
SHORTPULSE_DEVELOPMENT_PROJECT_REF=
SHORTPULSE_DEVELOPMENT_SUPABASE_URL=
SHORTPULSE_DEVELOPMENT_SUPABASE_REST_URL=
SHORTPULSE_DEVELOPMENT_DB_PASSWORD=
SHORTPULSE_DEVELOPMENT_DB_URL=
SHORTPULSE_DEVELOPMENT_SUPABASE_ANON_KEY=
SHORTPULSE_DEVELOPMENT_SUPABASE_SERVICE_ROLE_KEY=

# Optional staging Supabase project inputs.
SHORTPULSE_STAGING_PROJECT_REF=
SHORTPULSE_STAGING_SUPABASE_URL=
SHORTPULSE_STAGING_SUPABASE_REST_URL=
SHORTPULSE_STAGING_DB_PASSWORD=
SHORTPULSE_STAGING_POOLER_URL=
SHORTPULSE_STAGING_GITHUB_DB_URL=
SHORTPULSE_STAGING_SUPABASE_ANON_KEY=
SHORTPULSE_STAGING_SUPABASE_SERVICE_ROLE_KEY=
SHORTPULSE_STAGING_LIVE_URL=

# Optional production Supabase project inputs.
SHORTPULSE_PRODUCTION_PROJECT_REF=
SHORTPULSE_PRODUCTION_SUPABASE_PROJECT_REF=
SHORTPULSE_PRODUCTION_SUPABASE_URL=
SHORTPULSE_PRODUCTION_SUPABASE_REST_URL=
SHORTPULSE_PRODUCTION_DB_PASSWORD=
SHORTPULSE_PRODUCTION_POOLER_URL=
SHORTPULSE_PRODUCTION_SUPABASE_ANON_KEY=
SHORTPULSE_PRODUCTION_SUPABASE_SERVICE_ROLE_KEY=
SHORTPULSE_PRODUCTION_LIVE_URL=

# Optional hosted database URLs for Nuclo parity scripts.
SHORTPULSE_STAGING_DB_URL=
SHORTPULSE_PRODUCTION_DB_URL=

# Optional Supabase Management API token for local/provider auth-config checks.
# Keep this out of Vercel and never commit a real value.
SUPABASE_ACCESS_TOKEN=
SUPABASE_MANAGEMENT_API_TOKEN=

# Optional Supabase Storage S3 credentials for supported rclone migration.
SHORTPULSE_STAGING_S3_ENDPOINT=
SHORTPULSE_STAGING_S3_REGION=
SHORTPULSE_STAGING_S3_ACCESS_KEY_ID=
SHORTPULSE_STAGING_S3_SECRET_ACCESS_KEY=
SHORTPULSE_PRODUCTION_S3_ENDPOINT=
SHORTPULSE_PRODUCTION_S3_REGION=
SHORTPULSE_PRODUCTION_S3_ACCESS_KEY_ID=
SHORTPULSE_PRODUCTION_S3_SECRET_ACCESS_KEY=

# Protected internal worker route auth for hosted runtime probes.
SHORTPULSE_FAL_RECONCILER_CRON_SECRET=
SHORTPULSE_MEDIA_DERIVATIVES_CRON_SECRET=
SHORTPULSE_USER_HEALTH_FLEET_CRON_SECRET=
SHORTPULSE_INTERNAL_BILLING_RENEWALS_CRON_SECRET=
CRON_SECRET=

# Optional Supabase bootstrap token inputs (for --bootstrap-token-from-supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback app URL.
APP_BASE_URL=

# Optional Vercel operator tokens for deployment/env audits.
SHORTPULSE_VERCEL_API_TOKEN=
VERCEL_API_TOKEN=
SHORTPULSE_VERCEL_PROTECTION_BYPASS_TOKEN=
VERCEL_AUTOMATION_BYPASS_TOKEN=
SHORTPULSE_VERCEL_PROJECT_ID=
SHORTPULSE_VERCEL_PREVIEW_BRANCH=staging-preview

# Optional GitHub operator defaults for environment audits.
SHORTPULSE_GITHUB_REPO=

# Optional audit/e2e helper env.
PLAYWRIGHT_AUDIT_EMAIL=
PLAYWRIGHT_AUDIT_PASSWORD=
PLAYWRIGHT_BASE_URL=http://localhost:3100
AI_STUDIO_PERF_PORT=3100
AI_STUDIO_PERF_SKIP_BUILD=false

# Optional local governance/contract guardrail modes.
SHORTPULSE_MODEL_CATALOG_MAX_STALE_DAYS=45
SHORTPULSE_MODEL_CATALOG_STALE_MODE=warn
ARCHITECTURE_BOUNDARY_MODE=warn
REFERENCE_GRID_BOUNDARY_MODE=warn
REFERENCE_GRID_SIZE_BUDGET_MODE=warn
